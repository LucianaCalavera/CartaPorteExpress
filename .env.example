# Supabase (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exponer con prefijo NEXT_PUBLIC_. Solo Server Actions/Route Handlers (Regla de Oro #1).
SUPABASE_SERVICE_ROLE_KEY=

# Factura.com (PAC) — Sandbox primero.
# Contrato verificado contra factura.com/apidocs el 2026-08-27 (Regla de Oro #12).
# F-Api-Key/F-Secret-Key son POR TENANT en producción (Vault, ver profiles.pac_api_key_secret_id
# en supabase/migrations/001_initial_schema.sql) — estas vars son solo fallback para dev/tests
# locales mientras no existe la UI de Configuración (Sprint 4).
FACTURACOM_API_KEY=
FACTURACOM_API_SECRET=
# F-PLUGIN: token fijo de la integración (no por tenant), lo asigna Factura.com al registrar la app.
FACTURACOM_PLUGIN=
FACTURACOM_BASE_URL=https://sandbox.factura.com/api

# Meta Cloud API (WhatsApp) — Solicitar plantillas HSM en Sprint 0.
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Conekta (Pagos) — Link de pago simple v1.
CONEKTA_PRIVATE_KEY=
CONEKTA_PUBLIC_KEY=
CONEKTA_WEBHOOK_SIGNING_KEY=

# Resend (Email transaccional)
RESEND_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
